# Neon connection string (Vercel: Project Settings → Environment Variables)
NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Legacy name still supported locally if needed
# DATABASE_URL=

# Recommended on Vercel for Chromium on Node 22 (set in Vercel Dashboard, not .env file)
# AWS_LAMBDA_JS_RUNTIME=nodejs22.x
