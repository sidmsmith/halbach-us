# Neon connection string (Vercel + GitHub Actions secrets)
NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Vercel only: GitHub PAT with "Actions: Read and write" on sidmsmith/halbach-us
# Used by the refresh icon to start the GitHub Actions sync workflow
GITHUB_SYNC_TOKEN=

# Optional
# GITHUB_REPO=sidmsmith/halbach-us
# GITHUB_SYNC_REF=main
